rules_version = '2';

// Security model for this project: every admin write is authorized here,
// never by hiding buttons in the UI. Any signed-in Firebase user is treated
// as an admin (this project has no public sign-up — accounts are created
// by hand in the Firebase console), so `request.auth != null` is the whole
// admin check. Public reads are limited to published content.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    // Portfolio projects: anyone can read published work; only a signed-in
    // admin can read drafts or write at all.
    match /portfolioProjects/{projectId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Reference data the public pages read (categories, services, process
    // steps, equipment, site settings): public read, admin-only write.
    // processSteps has no admin screen yet (not part of the sidebar spec)
    // but keeps the same public-read rule.
    match /portfolioCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /processSteps/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /equipment/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: public insert-only, no public read (protects leads).
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin activity log (Registros screen): admin-only in both directions,
    // written by the admin panel itself as actions happen.
    match /adminLogs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Server-side video processing status (see functions/src/processVideo.ts
    // and src/lib/videoServerProcessing.ts). Written exclusively by Cloud
    // Functions using the Admin SDK, which always bypasses these rules —
    // the "allow write: if false" below is what stops anyone else,
    // including a signed-in admin's own browser, from writing a fake
    // "done" status directly. The client only ever reads a job's progress.
    match /videoProcessingJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anonymous, no-PII usage events (Relatórios screen): anyone can write
    // one (a page view or a WhatsApp/Instagram click), only an admin can
    // read the aggregate back. Never updated or deleted, only appended.
    match /analyticsEvents/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Default deny for anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
